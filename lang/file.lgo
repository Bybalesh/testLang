Prism.languages.turtle = {
	'comment': {
		pattern: /#.*/,
	TO square :size  ; Определяем процедуру с именем "square" и входным параметром "size"
  REPEAT 4 [FD :size RT 90] ; Повторяем 4 раза: вперед на "size" и поворот направо на 90 градусов
END ; Конец определения процедуры

CS ; Очистить экран и вернуть черепашку в центр
HT ; Спрятать черепашку

square 100 ; Вызываем процедуру "square" с размером 100
	greedy: true
	},
forward 100     ; двигаться вперед на 100 шагов
right 90        ; повернуть направо на 90 градусов
forward 100
right 90
forward 100
right 90
forward 100
